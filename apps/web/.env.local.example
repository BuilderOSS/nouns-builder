# DO NOT ADD DEFAULTS TO THIS FILE. This is only for secrets.
# If you want to add defaults use `.env` instead. To populate
# these run `npx vercel env pull .env.local`

ETHERSCAN_API_KEY=
REDIS_URL=

NEXT_PUBLIC_INFURA_API_KEY=
# browser key, locked to our domains with an allowlist
NEXT_PUBLIC_ALCHEMY_API_KEY=
# server-side auth: a JWT signing key (PKCS#8 PEM + Alchemy key ID), or a server-only key
ALCHEMY_JWT_PRIVATE_KEY=
ALCHEMY_JWT_KEY_ID=
ALCHEMY_API_KEY=
NEXT_PUBLIC_TENDERLY_RPC_KEY=

NEXT_PUBLIC_NETWORK_TYPE=mainnet/testnet

TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_USER=

PINATA_API_KEY=
NEXT_PUBLIC_PINATA_GATEWAY=

NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLET_CONNECT_METADATA=

# optional
SPLITS_API_KEY=

# optional
UNISWAP_API_KEY=

# Iron Session Configuration (for SIWE authentication)
# Generate a password with: openssl rand -base64 32
# Must be at least 32 characters long
IRON_PASSWORD=your-secret-here-at-least-32-chars

# For proposing Safe transactions
SAFE_API_KEY=

# AI transaction summaries (optional; summaries are hidden when none are set).
# Providers are tried in order: Groq -> Google -> Vercel AI Gateway.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Paid fallback: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Optional override, e.g. groq:llama-3.3-70b-versatile,google:gemini-3.5-flash-lite
AI_PROVIDER_CHAIN=
